-- #2 Cumulative Analysis (It helps business owners know if sales are growing or declining,
-- cumulative measures over date time)

-- Q1: Calculate the total sales per month (datetrunc function should come to mind)

SELECT order_month,
       total_sales,
       SUM(total_sales) OVER (ORDER BY order_month) AS running_total,
       AVG(avg_price)   OVER (ORDER BY order_month) AS moving_average
FROM(
SELECT DATETRUNC(month, order_date) AS order_month,
       SUM(sales) AS total_sales,
       AVG(price) AS avg_price
FROM sale
WHERE order_date IS NOT NULL
GROUP BY DATETRUNC(month, order_date)
)t
