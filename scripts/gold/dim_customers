CREATE VIEW gold.dim_customers AS
SELECT ROW_NUMBER() OVER (ORDER BY cst_id)  AS customer_key,
       ci.cst_id                            AS customer_id,
       ci.cst_key                           AS customer_number,
       ci.cst_firtsname                     AS first_name,
       ci.cst_lastname                      AS last_name,
       el.cntry                             AS country,
       ci.cst_material_status               AS marital_status,
       CASE 
            WHEN ci.cst_gndr != 'Unknown' THEN ci.cst_gndr
            ELSE COALESCE(ec.gen, 'Unknown')
        END                                 AS gender,
        ec.bdate                            AS birth_date,
       ci.cst_create_date                   AS create_date
FROM silver.crm_cust_info ci
LEFT JOIN silver.erp_cust_az12 ec
ON   ci.cst_key = ec.cid
LEFT JOIN silver.erp_loc_a101 el
ON ci.cst_key = el.cid
WHERE ci.cst_key LIKE 'AW%';
