CREATE VIEW gold.dim_customers AS
SELECT ROW_NUMBER() OVER (ORDER BY cst_id)  AS customer_key,
       ci.cst_id                            AS customer_id,
       ci.cst_key                           AS customer_number,
       ci.cst_firtsname                     AS first_name,
       ci.cst_lastname                      AS last_name,
       el.cntry                             AS country,
       ci.cst_material_status               AS marital_status,
       CASE 
            WHEN ci.cst_gndr != 'Unknown' THEN ci.cst_gndr
            ELSE COALESCE(ec.gen, 'Unknown')
        END                                 AS gender,
        ec.bdate                            AS birth_date,
       ci.cst_create_date                   AS create_date
FROM silver.crm_cust_info ci
LEFT JOIN silver.erp_cust_az12 ec
ON   ci.cst_key = ec.cid
LEFT JOIN silver.erp_loc_a101 el
ON ci.cst_key = el.cid
WHERE ci.cst_key LIKE 'AW%';

CREATE VIEW gold.dim_products AS
           SELECT  ROW_NUMBER() OVER (ORDER BY pc.prd_id) AS product_key,
                   pc.prd_id         AS product_id,
                   pc.prd_key        AS product_number,
                   pc.prd_nm         AS product_name,
                   pc.cat_id         AS category_id,
                   pe.cat            AS category,
                   pe.subcat         AS subcategory,
                   pe.maintenance,
                   pc.prd_cost       AS product_cost,
                   pc.prd_line       AS product_line,
                   pc.prd_start_dt   AS start_date
        FROM silver.crm_prd_info pc
        LEFT JOIN silver.erp_px_cat_g1v2 pe
        ON pc.cat_id = pe.id
        WHERE pc.prd_end_dt IS NULL; -- filter only current data


CREATE VIEW gold.fact_sales AS
SELECT sc.sls_ord_num   AS order_mumber,
       pr.product_key,
       cu.customer_key,
       sc.sls_order_dt  AS order_date,
       sc.sls_ship_dt   AS ship_date,
       sc.sls_due_dt    AS due_date,
       sc.sls_quantity  AS quantity,
       sc.sls_price     AS price,
       sc.sls_sales     AS sales
FROM silver.crm_sales_details sc
LEFT JOIN gold.dim_products pr
ON sc.sls_prd_key = pr.product_number
LEFT JOIN gold.dim_customers cu
ON sc.sls_cust_id = cu.customer_id;
