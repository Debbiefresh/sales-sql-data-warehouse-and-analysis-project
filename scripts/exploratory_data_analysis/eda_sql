-- #1 Database Exploration

-- Q1: explore all objects in the database

SELECT * FROM INFORMATION_SCHEMA.TABLES;

-- Q2: explore all columns in the database

SELECT * FROM INFORMATION_SCHEMA.COLUMNS;


-- #2 Dimension Exploration

-- Q1: explore all countries our customers live

SELECT DISTINCT country
FROM customers;

-- Q2: explore all product categories and subcategories in the product's table

SELECT DISTINCT category, subcategory, product_name
FROM products;

-- #3 Date Exploration

-- Q1: years of sales are available?

SELECT MIN(order_date)  AS first_order_date,
       MAX(order_date)  AS last_order_date,
	   DATEDIFF(year, MIN(order_date), MAX(order_date)) AS order_range_years
FROM sale;

-- Q2: what are the dates of out youngest and oldest customers?

SELECT MIN(birth_date)  AS oldest_customer_birthdate,
       DATEDIFF(year, MIN(birth_date), GETDATE()) AS oldest_customer_age,
       MAX(birth_date)  AS youngest_customer_birthdate,
	   DATEDIFF(year, MAX(birth_date), GETDATE())  AS youngest_customer_age
FROM customers;


-- #4 Measures Exploration

-- Q1: total sales

SELECT SUM(sales)  AS total_sales
FROM sale;

-- Q2: how many items are sold

SELECT SUM(quantity) AS total_quantity_sold
FROM sale;

-- Q3: average selling price

SELECT AVG(price) AS avg_price
FROM sale;

-- Q4: total number of orders

SELECT COUNT(DISTINCT order_number) AS total_orders
FROM sale;

-- Q5: total number of products

SELECT COUNT(product_key) AS total_products
FROM products;


-- Q6: total number of customers

SELECT COUNT(customer_key) AS total_customers
FROM customers;

-- Q7: find the total number of customers that has placed orders

SELECT COUNT(DISTINCT customer_key) total_customers_placed_orders
FROM sale;

-- Generate a report that shows all the key metrics of the report

SELECT 'Total Sales' AS measure_name, SUM(sales) AS measure_value FROM sale
UNION ALL
SELECT 'Total_Quantity' AS measure_name, SUM(quantity) AS measure_value FROM sale
UNION ALL
SELECT 'Average_Price' AS measure_name, AVG(price) AS measure_value FROM sale
UNION ALL
SELECT 'Total_Orders' AS measure_name, COUNT(DISTINCT order_number) AS measure_value FROM sale
UNION ALL
SELECT 'Total_Products' AS measure_name, COUNT(product_key) AS measure_value FROM products
UNION ALL
SELECT 'Total_Customers' AS measure_name, COUNT(customer_key) AS measure_value FROM customers
UNION ALL
SELECT 'Total_Customers_Placed_Orders' AS measure_name, COUNT(DISTINCT customer_key) AS measure_value FROM sale;


-- #5 Magnitute Exploration

-- Q1: total customers by countries

SELECT country, COUNT(customer_key) AS total_customers
FROM customers 
GROUP BY country
ORDER BY country;

-- Q2: total customers by gender

SELECT gender, COUNT(customer_key) AS total_customers
FROM customers 
GROUP BY gender
ORDER BY total_customers DESC;


-- Q3: total product by category

SELECT category, COUNT(product_key) AS total_product
FROM products 
GROUP BY category
ORDER BY total_product DESC;


-- Q4: average cost in each category

SELECT category, AVG(product_cost) AS avg_cost
FROM products 
GROUP BY category
ORDER BY avg_cost DESC;

-- Q5: total revenue generated by each category

SELECT p.category,
       SUM(s.sales) AS total_revenue
FROM sale s
LEFT JOIN products p
ON s.product_key = p.product_key
GROUP BY p.category
ORDER BY total_revenue DESC;


-- Q6: total revenue generated by each customer

SELECT c.customer_key,
       c.first_name,
	   c.last_name,
       SUM(s.sales) AS total_revenue
FROM sale s
LEFT JOIN customers c
ON s.customer_key = c.customer_key
GROUP BY c.customer_key, c.first_name,
	   c.last_name
ORDER BY total_revenue DESC;


-- Q7: distribution of sold items across countries

SELECT c.country,
       SUM(s.quantity) AS total_quantity
FROM sale s
LEFT JOIN customers c
ON s.customer_key = c.customer_key
GROUP BY c.country	   
ORDER BY total_quantity DESC;


-- #6 Ranking Exploration

-- Q1: top 5 products that generate the highest revenue?

SELECT TOP 5
	   p.product_name,
       SUM(s.sales)   AS total_revenue
FROM sale s
JOIN products p
ON s.product_key = p.product_key
GROUP BY p.product_name
ORDER BY total_revenue DESC;


-- Q2: the worst 5 underperforming products in terms of revenue?

SELECT TOP 5
	   p.product_name,
       SUM(s.sales)   AS total_revenue
FROM sale s
JOIN products p
ON s.product_key = p.product_key
GROUP BY p.product_name
ORDER BY total_revenue;

-- Q3: top 10 customers who generated the highest revenue?

SELECT TOP 10
	   c.customer_key,
	   c.first_name,
	   c.last_name,
       SUM(s.sales)   AS total_revenue
FROM sale s
LEFT JOIN customers c
ON s.customer_key = c.customer_key
GROUP BY c.customer_key,
	   c.first_name,
	   c.last_name
ORDER BY total_revenue DESC;


-- Q4: the 3 customers with the fewest orders

SELECT TOP 3
       s.customer_key,
       c.first_name,
	   c.last_name,
	   COUNT(DISTINCT s.order_number) AS total_orders
FROM sale s
JOIN customers c
ON s.customer_key = c.customer_key
GROUP BY s.customer_key,
       c.first_name,
	   c.last_name 
ORDER BY total_orders;
